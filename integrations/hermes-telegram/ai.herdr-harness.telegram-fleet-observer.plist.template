<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.herdr-harness.telegram-fleet-observer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/node</string>
    <string>/absolute/path/to/HerdrHarness-lite/dist/src/fleet-observer.js</string>
    <string>run</string>
    <string>--config</string>
    <string>/absolute/path/to/fleet-observer.config.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/absolute/path/to/fleet-observer.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/fleet-observer.error.log</string>
</dict>
</plist>
