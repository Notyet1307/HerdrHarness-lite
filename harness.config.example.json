{
  "repo": "owner/repository",
  "localPath": "/absolute/path/to/repository",
  "baseRef": "main",
  "autoMerge": false,
  "readyLabel": "ready-for-agent",
  "claimLabel": "agent:claimed",
  "stateDir": "/absolute/path/to/.herdr-harness-lite",
  "worktreeRoot": "/absolute/path/to/worktrees",
  "maxReviewRounds": 3,
  "maxAnalystTurns": 3,
  "workerRuntime": "herdr-pi-cli",
  "reviewerRuntime": "pi-rpc",
  "workerCompaction": {
    "mode": "disabled"
  },
  "diagnostics": {
    "projectId": "product-api",
    "redactRepo": false,
    "redactIssue": false
  },
  "worker": {
    "totalTimeoutMs": 5400000,
    "noProgressTimeoutMs": 900000
  },
  "reviewer": {
    "totalTimeoutMs": 2700000,
    "noProgressTimeoutMs": 600000,
    "axisConcurrency": 2
  },
  "validation": {
    "totalTimeoutMs": 1800000
  },
  "termination": {
    "sigtermGraceMs": 10000,
    "sigkillGraceMs": 5000
  },
  "reviewerProviderProfiles": {
    "active": "openai-subscription",
    "profiles": {
      "openai-subscription": {
        "credentialMode": "canonical-oauth",
        "provider": "openai-codex",
        "model": "gpt-5.6-sol"
      },
      "custom": {
        "credentialMode": "canonical-model-config",
        "provider": "baizhi-chat",
        "model": "deepseek-v4-flash"
      }
    }
  },
  "preflight": {
    "piBin": "pi",
    "dockerRequired": false
  },
  "reviewerValidationArgv": [
    "npm",
    "run",
    "verify"
  ],
  "workerArgv": [
    "--no-approve",
    "--no-skills",
    "--no-session",
    "--no-extensions",
    "--no-context-files",
    "--no-prompt-templates",
    "--no-themes",
    "--extension",
    "/absolute/path/to/HerdrHarness-lite/pi/extensions/worker-tools.js",
    "--extension",
    "/absolute/path/to/.pi/agent/git/github.com/DietrichGebert/ponytail/pi-extension/index.js",
    "--skill",
    "/absolute/path/to/.agents/skills/implement",
    "--skill",
    "/absolute/path/to/HerdrHarness-lite/pi/skills/tdd",
    "--skill",
    "/absolute/path/to/HerdrHarness-lite/pi/skills/focused-self-check",
    "--tools",
    "read,bash,edit,write,grep,find,ls,worker_submit",
    "--thinking",
    "high"
  ],
  "reviewerArgv": [
    "--no-approve",
    "--no-skills",
    "--no-session",
    "--no-extensions",
    "--no-context-files",
    "--no-prompt-templates",
    "--no-themes",
    "--extension",
    "/absolute/path/to/HerdrHarness-lite/pi/extensions/reviewer-subagent-config.js",
    "--extension",
    "/absolute/path/to/.pi/agent/npm/node_modules/pi-subagents/index.ts",
    "--extension",
    "/absolute/path/to/HerdrHarness-lite/pi/extensions/reviewer-tools.js",
    "--skill",
    "/absolute/path/to/HerdrHarness-lite/pi/skills/code-review",
    "--provider",
    "openai-codex",
    "--model",
    "gpt-5.6-sol",
    "--tools",
    "read,grep,find,ls,subagent,review_preflight,review_submit",
    "--thinking",
    "max"
  ],
  "herdr": {
    "bin": "herdr",
    "session": "herdr-harness"
  },
  "analyst": {
    "command": "/absolute/path/to/node",
    "argv": [
      "/absolute/path/to/HerdrHarness-lite/dist/src/codex-analyst-wrapper.js",
      "--state-dir",
      "/absolute/path/to/.herdr-harness-lite",
      "--codex-bin",
      "/absolute/path/to/codex"
    ]
  }
}
