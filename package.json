{
  "name": "herdr-harness-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "verify": "npm run typecheck && npm test",
    "check:telegram-fixtures": "npm run build && node scripts/telegram-transport-fixtures.mjs",
    "check:telegram-contract": "node scripts/check-telegram-transport-contract.mjs",
    "canary:telegram-transport": "npm run build && node scripts/telegram-transport-integration-canary.mjs"
  },
  "bin": {
    "herdr-harness-lite": "./dist/src/cli.js",
    "herdr-harness-fleet": "./dist/src/fleet-cli.js",
    "herdr-harness-canary": "./dist/src/canary-cli.js",
    "herdr-harness-transport": "./dist/src/transport-cli.js",
    "herdr-harness-project-observer": "./dist/src/hermes-observer.js",
    "herdr-harness-fleet-observer": "./dist/src/fleet-observer.js",
    "codex-analyst-wrapper": "./dist/src/codex-analyst-wrapper.js"
  },
  "pi": {
    "skills": [
      "./pi/skills"
    ],
    "subagents": {
      "agents": [
        "./pi/agents"
      ]
    }
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
