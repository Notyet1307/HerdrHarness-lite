{
  "name": "herdr-harness-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "verify": "npm run typecheck && npm test"
  },
  "bin": {
    "herdr-harness-lite": "./dist/src/cli.js",
    "codex-analyst-wrapper": "./dist/src/codex-analyst-wrapper.js"
  },
  "pi": {
    "skills": [
      "./pi/skills"
    ],
    "subagents": {
      "agents": [
        "./pi/agents"
      ]
    }
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
